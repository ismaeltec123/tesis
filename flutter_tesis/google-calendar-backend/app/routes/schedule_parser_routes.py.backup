"""
Rutas para parsear horarios desde imágenes JPG/PNG
NOTA: El procesamiento OCR ahora se hace en un servicio Docker externo
Este módulo solo mantiene las vistas/endpoints para compatibilidad con Flutter
"""

from fastapi import APIRouter, File, UploadFile, Form, HTTPException
from fastapi.responses import JSONResponse
import logging
import httpx
import os
from typing import Optional

# Configurar logging
logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

# URL del servicio Docker de OCR (configurable por variable de entorno)
OCR_SERVICE_URL = os.getenv("OCR_SERVICE_URL", "http://localhost:8002")
logger.info(f"🐳 Servicio OCR Docker configurado en: {OCR_SERVICE_URL}")

router = APIRouter(prefix="/schedule-parser", tags=["Schedule Parser"])


async def parse_schedule_from_docker_service(
    image_bytes: bytes, 
    teacher_id: str, 
    section: str
) -> list:
    """
    Envía la imagen al servicio Docker de OCR y retorna los horarios parseados
    
    Args:
        image_bytes: Bytes de la imagen
        teacher_id: ID del profesor
        section: Sección del curso
    
    Returns:
        Lista con TODAS las clases (semanas pares e impares)
    """
    try:
        logger.info(f"🐳 Enviando imagen al servicio Docker OCR: {OCR_SERVICE_URL}")
        
        async with httpx.AsyncClient(timeout=30.0) as client:
            # Preparar el multipart form data
            files = {"file": ("schedule.jpg", image_bytes, "image/jpeg")}
            data = {
                "teacher_id": teacher_id,
                "section": section or ""
            }
            
            # Enviar request al servicio Docker
            response = await client.post(
                f"{OCR_SERVICE_URL}/api/process-schedule",
                files=files,
                data=data
            )
            
            if response.status_code == 200:
                result = response.json()
                schedules = result.get("schedules", [])
                logger.info(f"✅ Servicio Docker retornó {len(schedules)} clases")
                return schedules
            else:
                logger.error(f"❌ Error del servicio Docker: {response.status_code} - {response.text}")
                raise HTTPException(
                    status_code=502,
                    detail=f"Error en servicio OCR Docker: {response.status_code}"
                )
                
    except httpx.TimeoutException:
        logger.error("⏱️ Timeout conectando con servicio Docker OCR")
        raise HTTPException(
            status_code=504,
            detail="Timeout: Servicio OCR no responde"
        )
    except httpx.ConnectError:
        logger.error(f"🔌 No se puede conectar al servicio Docker OCR en {OCR_SERVICE_URL}")
        raise HTTPException(
            status_code=503,
            detail=f"Servicio OCR no disponible en {OCR_SERVICE_URL}"
        )
    except Exception as e:
        logger.error(f"❌ Error inesperado comunicándose con servicio Docker: {str(e)}")
        raise HTTPException(
            status_code=500,
            detail=f"Error procesando con servicio OCR: {str(e)}"
        )


    """
    Parsea un horario desde imagen usando OCR (Tesseract)
    Si OCR falla o no está instalado, usa datos MOCK como fallback
    
    Args:
        image_bytes: Bytes de la imagen
        teacher_id: ID del profesor
        section: Sección del curso
    
    Returns:
        Lista con TODAS las clases (semanas pares e impares)
    """
    
    # INTENTAR PROCESAR CON OCR PRIMERO
    if OCR_AVAILABLE and process_schedule_image:
        try:
            logger.info("🔍 Intentando procesar imagen con OCR (PaddleOCR/Tesseract fallback)...")
            ocr_result = process_schedule_image(image_bytes, teacher_id, section)
            
            if ocr_result and len(ocr_result) > 0:
                logger.info(f"✅ OCR exitoso: {len(ocr_result)} clases extraídas")
                return ocr_result
            else:
                logger.warning("⚠️ OCR no extrajo datos suficientes, usando MOCK como fallback")
        
        except Exception as e:
            logger.warning(f"⚠️ OCR falló: {str(e)}, usando datos MOCK como fallback")
    else:
        logger.info("ℹ️ OCR no disponible, usando datos MOCK")
    
    # FALLBACK: Datos MOCK si OCR falla o no está disponible
    logger.info("📋 Usando datos MOCK (Tesseract no disponible o falló)")
    
    # Horario real de TECSUP - 1C5(A-B) Primer Semestre - Electrónica y Automatización Industrial - Grupo A-B
