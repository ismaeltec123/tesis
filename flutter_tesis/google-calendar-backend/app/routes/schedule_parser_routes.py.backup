@router.post("/parse-schedule")
async def parse_schedule_endpoint(
    file: UploadFile = File(...),
    teacher_id: str = Form(...),
    section: str = Form(""),
    note: str = Form("")
    # REMOVIDO: week_type - ahora importamos TODAS las semanas
):
    """
    Endpoint para parsear horario desde imagen JPG/PNG
    Parámetros:
    - file: Imagen del horario (JPG/PNG)
    - teacher_id: ID del profesor
    - section: Sección del curso
    - note: Notas adicionales
    
    NOTA: Ahora importa AMBAS semanas (par e impar) para que el usuario pueda cambiar la visualización
    """
    try:
        logger.info(f"📨 Recibida petición de parseo:")
        logger.info(f"  - Archivo: {file.filename}")
        logger.info(f"  - Content-Type: {file.content_type}")
        logger.info(f"  - Teacher ID: {teacher_id}")
        logger.info(f"  - Sección: {section}")
        
        # Leer el archivo primero
        image_bytes = await file.read()
        logger.info(f"  - Tamaño del archivo: {len(image_bytes)} bytes")
        
        # Validar que no esté vacío
        if len(image_bytes) == 0:
            raise HTTPException(status_code=400, detail="El archivo está vacío")
        
        # Validar que es una imagen válida (más flexible que content_type)
        try:
            img = Image.open(io.BytesIO(image_bytes))
            img.verify()
            logger.info(f"✅ Imagen válida: {img.format} {img.size}")
        except Exception as e:
            logger.error(f"❌ Imagen inválida: {str(e)}")
            raise HTTPException(status_code=400, detail=f"Archivo de imagen inválido: {str(e)}")
        
        # Validación adicional por extensión si content_type falla
        if file.filename:
            valid_extensions = ['.jpg', '.jpeg', '.png', '.gif', '.bmp']
            if not any(file.filename.lower().endswith(ext) for ext in valid_extensions):
                logger.warning(f"⚠️ Extensión de archivo sospechosa: {file.filename}")
        
        # Log adicional para content_type
        if not file.content_type or not file.content_type.startswith('image/'):
            logger.warning(f"⚠️ Content-Type sospechoso: {file.content_type}, pero la imagen es válida")
        else:
            logger.info(f"✅ Content-Type válido: {file.content_type}")
        
        # Parsear el horario - IMPORTA TODAS LAS SEMANAS (par e impar)
        schedules = parse_schedule_from_image(image_bytes, teacher_id, section)
        
        # NO filtrar por semana - devolver TODAS las clases
        
        # Agregar metadatos a cada schedule
        for schedule in schedules:
            schedule["id"] = str(uuid.uuid4())
            schedule["teacher_id"] = teacher_id
            schedule["section"] = section if section else None
            schedule["note"] = note
            schedule["parsed_at"] = datetime.now().isoformat()
        
        logger.info(f"✅ Horario parseado exitosamente: {len(schedules)} clases encontradas (pares e impares)")
        
        # 📧 Send notification email about successful import
        try:
            from ..services.email_service import email_service
            
            # Count by week type
            impar_count = sum(1 for s in schedules if s.get('week_type') == 'impar')
            par_count = sum(1 for s in schedules if s.get('week_type') == 'par')
            
            details = f"""
Semana Impar: {impar_count} clases
Semana Par: {par_count} clases

Archivo: {file.filename}
Sección: {section if section else 'No especificada'}
"""
            await email_service.send_schedule_imported_notification(len(schedules), details)
            logger.info("📧 Email notification sent")
        except Exception as email_error:
            logger.warning(f"⚠️ Could not send email notification: {email_error}")
        
        return JSONResponse(content={
            "success": True,
            "message": f"Horario parseado exitosamente. Se encontraron {len(schedules)} clases (ambas semanas).",
            "schedules": schedules,
            "metadata": {
                "teacher_id": teacher_id,
                "section": section,
                "note": note,
                "filename": file.filename,
                "file_size": len(image_bytes),
                "parsed_at": datetime.now().isoformat()
            }
        })
        
    except HTTPException:
        raise
    except Exception as e:
        logger.error(f"❌ Error parseando horario: {str(e)}")
        raise HTTPException(status_code=500, detail=f"Error interno del servidor: {str(e)}")

@router.get("/test-parser")
async def test_parser():
    """
    Endpoint de prueba para verificar que el parser funciona
    """
    return JSONResponse(content={
        "message": "Parser de horarios funcionando correctamente",
        "version": "1.0.0",
        "supported_formats": ["JPG", "PNG", "JPEG"],
        "features": [
            "Detección automática de clases",
            "Extracción de horarios",
            "Identificación de aulas",
            "Asignación por secciones"
        ]
    })